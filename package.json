{
  "name": "isqolar",
  "version": "0.1.0",
  "description": "Every Iskolar, in the right line.",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "hub": "HUB_FILE=hub-state.json SEED=1 tsx src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx/esm --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "maplibre-gl": "^5.24.0",
    "tsx": "^4.0.0"
  }
}
